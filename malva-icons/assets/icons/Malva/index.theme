[Icon Theme]
Name=Malva
Comment=Malva icons. One scalable SVG per icon serves every size; symbolic glyphs take the text colour.
Inherits=Adwaita,hicolor
Example=folder
Directories=scalable/apps,scalable/categories,scalable/devices,scalable/mimetypes,scalable/places,scalable/status,symbolic/actions,symbolic/apps,symbolic/categories,symbolic/devices,symbolic/emblems,symbolic/legacy,symbolic/mimetypes,symbolic/places,symbolic/status,symbolic/ui

[scalable/apps]
Context=Applications
Size=128
MinSize=8
MaxSize=1024
Type=Scalable

[scalable/categories]
Context=Categories
Size=128
MinSize=8
MaxSize=1024
Type=Scalable

[scalable/devices]
Context=Devices
Size=128
MinSize=8
MaxSize=1024
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=128
MinSize=8
MaxSize=1024
Type=Scalable

[scalable/places]
Context=Places
Size=128
MinSize=8
MaxSize=1024
Type=Scalable

[scalable/status]
Context=Status
Size=128
MinSize=8
MaxSize=1024
Type=Scalable

